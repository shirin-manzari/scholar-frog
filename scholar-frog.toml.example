[index]
embedding_model = "BAAI/bge-small-en-v1.5"
# Pin this to a Hugging Face commit hash for reproducible model downloads.
# embedding_revision = "<commit-hash>"
embedding_dimension = 384
normalize_embeddings = true

# Local embedding-tokenizer tokens, excluding special tokens.
chunk_size = 300
chunk_overlap = 50
chunking_strategy = "sentence-token"

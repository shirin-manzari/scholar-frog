# Choose generation backend: "ollama" (local, free) or "openai" or "anthropic"
LLM_BACKEND=ollama

# Optional index overrides also accepted in scholar-frog.toml
# SCHOLAR_FROG_CHUNK_SIZE=300
# SCHOLAR_FROG_CHUNK_OVERLAP=50

# Used if LLM_BACKEND=ollama (make sure `ollama serve` is running)
OLLAMA_MODEL=qwen3:8b
OLLAMA_URL=http://localhost:11434
OLLAMA_TIMEOUT=180

# Retrieval mode: dense, hybrid, or hybrid-rerank
RETRIEVAL_MODE=hybrid-rerank
# Query-only encoding policy: auto adds the BGE instruction ONLY for the exact
# BAAI/bge-small-en-v1.5 model; off reproduces unprefixed dense encoding.
# BM25, documents, reranking and generation never receive this instruction.
QUERY_INSTRUCTION=auto
# Experimental, deterministic aliases from committed text/title definitions.
# No external model/service. Keep opt-in pending representative evaluation.
QUERY_EXPANSION=false
# Shared allowance for corrections, plan subqueries and aliases; hard cap 2.
# 0 searches only the original question; the original is always searched.
QUERY_MAX_VARIANTS=2
# Candidate budgets below are TOTALS per method across all queries. When variants
# exist, the original receives ceil(total/2); variants share the remainder.
DENSE_CANDIDATES=50
BM25_CANDIDATES=50
RRF_K=60
RERANK_CANDIDATES=40
# Maximum independently selected anchors; context can contain more evidence blocks.
FINAL_RESULTS=5
RERANKER_MODEL=BAAI/bge-reranker-base
# Calibrated for the default reranker; tune against your own evaluation set.
RERANKER_MIN_SCORE=0.01
MAX_CHUNKS_PER_PAPER=2
# 1.0 favors relevance only; lower values increase lexical diversity.
MMR_LAMBDA=0.75
# Paragraph radius after anchor selection (same section and committed version).
CONTEXT_PARAGRAPHS=1
# Additional formatted context budget AFTER all anchors are reserved (0 disables expansion).
CONTEXT_EXPANSION_TOKENS=1500
# Do not cross section IDs unless explicitly disabled.
CONTEXT_SAME_SECTION=true
# Matching generation tokenizer, already downloaded locally (optional).
# LLM_TOKENIZER_PATH=/path/to/generation-model-tokenizer
# OpenAI also uses tiktoken if its matching encoding is already cached locally.
# Otherwise one token per UTF-8 byte is used: conservative, reported, not a guarantee.
# Total formatted evidence budget, including all anchors and optional context.
CONTEXT_BUDGET_TOKENS=4000
# Full generation window: evidence, question, system instructions, chat formatting,
# retry headroom and answer. Set to a context size actually supported by your model.
# The byte estimate can require larger budgets than the old embedding-token counts.
# Never increase the window beyond the generation model's supported size.
CONTEXT_WINDOW_TOKENS=8192
CONTEXT_ANSWER_RESERVE=1024
# Chat framing overhead; increase for backend templates with larger overhead.
CONTEXT_FRAMING_RESERVE=32
# Headroom for citation retry feedback; every actual request is checked again.
CONTEXT_RETRY_RESERVE=256
# ADJACENT_CHUNKS is deprecated; neighbors no longer consume ranked-hit slots.

# Require --force when a sync removes more than this share of indexed papers
SYNC_DELETE_THRESHOLD=0.5

# Citation reference checks (query-local [E1] IDs)
CITATION_MAX_RETRIES=1
CITATION_COVERAGE_WARNINGS=true
CITATION_SEMANTIC_VALIDATION=true

# Used if LLM_BACKEND=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Used if LLM_BACKEND=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

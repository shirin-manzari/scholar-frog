# Choose generation backend: "ollama" (local, free) or "openai" or "anthropic"
LLM_BACKEND=ollama

# Optional index overrides also accepted in scholar-frog.toml
# SCHOLAR_FROG_CHUNK_SIZE=300
# SCHOLAR_FROG_CHUNK_OVERLAP=50

# Used if LLM_BACKEND=ollama (make sure `ollama serve` is running)
OLLAMA_MODEL=qwen3:8b
OLLAMA_URL=http://localhost:11434
OLLAMA_TIMEOUT=180

# Retrieval mode: dense, hybrid, or hybrid-rerank
RETRIEVAL_MODE=hybrid-rerank
DENSE_CANDIDATES=50
BM25_CANDIDATES=50
RRF_K=60
RERANK_CANDIDATES=40
FINAL_RESULTS=5
RERANKER_MODEL=BAAI/bge-reranker-base
# Calibrated for the default reranker; tune against your own evaluation set.
RERANKER_MIN_SCORE=0.01
MAX_CHUNKS_PER_PAPER=2
# 1.0 favors relevance only; lower values increase lexical diversity.
MMR_LAMBDA=0.75
# Paragraph radius after anchor selection (same section and committed version).
CONTEXT_PARAGRAPHS=1
# Formatted evidence token budget, measured with the local embedding tokenizer.
CONTEXT_BUDGET_TOKENS=4000
# Estimated full generation window, including question/instructions and answer.
# Set this to your backend's supported context size; tokenizers may differ.
CONTEXT_WINDOW_TOKENS=8192
CONTEXT_ANSWER_RESERVE=1024
# ADJACENT_CHUNKS is deprecated; neighbors no longer consume ranked-hit slots.

# Require --force when a sync removes more than this share of indexed papers
SYNC_DELETE_THRESHOLD=0.5

# Citation reference checks (query-local [E1] IDs)
CITATION_MAX_RETRIES=1
CITATION_COVERAGE_WARNINGS=true
CITATION_SEMANTIC_VALIDATION=true

# Used if LLM_BACKEND=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Used if LLM_BACKEND=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

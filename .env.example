# Choose generation backend: "ollama" (local, free) or "openai" or "anthropic"
LLM_BACKEND=ollama

# Optional index overrides also accepted in scholar-frog.toml
# SCHOLAR_FROG_CHUNK_SIZE=800

# Used if LLM_BACKEND=ollama (make sure `ollama serve` is running)
OLLAMA_MODEL=qwen3:8b
OLLAMA_URL=http://localhost:11434
OLLAMA_TIMEOUT=180

# Retrieval mode: dense, hybrid, or hybrid-rerank
RETRIEVAL_MODE=hybrid-rerank
DENSE_CANDIDATES=20
BM25_CANDIDATES=20
RRF_K=60
RERANK_CANDIDATES=20
FINAL_RESULTS=5
RERANKER_MODEL=BAAI/bge-reranker-base

# Require --force when a sync removes more than this share of indexed papers
SYNC_DELETE_THRESHOLD=0.5

# Citation reference checks (query-local [E1] IDs)
CITATION_MAX_RETRIES=1
CITATION_COVERAGE_WARNINGS=true

# Used if LLM_BACKEND=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Used if LLM_BACKEND=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
